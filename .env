# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Keys
JWT_SECRET=stocksight_bloomberg_jwt_access_secret_2026_key
JWT_REFRESH_SECRET=stocksight_bloomberg_jwt_refresh_secret_2026_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL Database Configuration (Optional - falls back gracefully to in-memory if offline)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=stocksight_db

# Financial Modeling Prep (FMP) API Key
FMP_API_KEY=

# Finnhub API Key
FINNHUB_API_KEY=

# Cache TTL Configurations (in seconds)
CACHE_TTL_PRICE=30
CACHE_TTL_NEWS=600
CACHE_TTL_FUNDAMENTALS=3600

# Rate Limiting Configurations
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
